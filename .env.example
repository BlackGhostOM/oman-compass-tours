# ---------------------------------------------------------------------------
# Oman Compass Tours — environment variables
# Copy to .env.local for Next.js. Server-side secrets marked [convex] must be
# set on the Convex deployment:  npx convex env set NAME value
# ---------------------------------------------------------------------------

# --- Next.js (public) -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://omancompasstours.com
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
CONVEX_DEPLOYMENT=dev:your-deployment            # written by `npx convex dev`

# Maps / analytics (public, loaded only after cookie consent where applicable)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set to 1 only after AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET exist on the Convex deployment (enables the Google button)
NEXT_PUBLIC_AUTH_GOOGLE=0

# Stripe publishable key (Elements / Payment Request button)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Convex deployment secrets [convex] ------------------------------------
# Auth
# SITE_URL=https://omancompasstours.com          # used by Convex Auth for redirects
# JWT_PRIVATE_KEY=                               # generated: npx @convex-dev/auth  (or see README)
# JWKS=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=re_...                         # magic links + transactional email
# EMAIL_FROM="Oman Compass Tours <bookings@omancompasstours.com>"
# STAFF_NOTIFICATION_EMAIL=omancompasstours@gmail.com

# Payments
# THAWANI_SECRET_KEY=
# THAWANI_PUBLISHABLE_KEY=
# THAWANI_MODE=uat                               # uat | production
# THAWANI_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox                            # sandbox | live
# PAYPAL_WEBHOOK_ID=

# AI assistant
# ANTHROPIC_API_KEY=sk-ant-...

# Anti-abuse
# TURNSTILE_SECRET_KEY=

# FX display rates (optional; falls back to pegged approximations)
# FX_API_URL=https://open.er-api.com/v6/latest/OMR
